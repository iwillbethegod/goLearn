# Day-6 environment template. Copy to .env and adjust:
#
#   cp .env.example .env
#
# .env is gitignored. Real credentials NEVER live in compose.yaml or
# code; they're injected via env at runtime. The Makefile targets and
# `cmd/api -db-dsn` both read DATABASE_URL by default.

# --- Postgres credentials (compose.yaml reads these) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

# --- Application DSN (cmd/api / cmd/ingest / cmd/consumer read this) ---
# When the binaries run on the HOST (not inside compose):
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable

# --- NATS JetStream (Day 6) ---
NATS_URL=nats://localhost:4222
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# --- OpenTelemetry (Day 6) ---
# Empty OTEL_EXPORTER_OTLP_ENDPOINT + empty OTEL_TRACES_EXPORTER ⇒
# no-op TracerProvider (zero overhead, fine for tests).
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=goLearn-api
OTEL_TRACES_EXPORTER=otlp        # otlp | stdout | none
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# --- Token bucket overrides (optional; defaults from config/tokens.yaml) ---
# TOKENS_CAPACITY=20000
# TOKENS_RATE_PER_MIN=10000

# --- Ingest CLI password (optional; -password flag overrides) ---
# INGEST_PASSWORD=secret123
