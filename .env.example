# Day-5 environment template. Copy to .env and adjust:
#
#   cp .env.example .env
#
# .env is gitignored. Real credentials NEVER live in compose.yaml or
# code; they're injected via env at runtime. The Makefile targets and
# `cmd/api -db-dsn` both read DATABASE_URL by default.

# --- Postgres credentials (compose.yaml reads these) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

# --- Application DSN (cmd/api / cmd/ingest read this) ---
# When the api / ingest binaries run on the HOST (not inside compose):
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable

# --- Token bucket overrides (optional; defaults from config/tokens.yaml) ---
# TOKENS_CAPACITY=20000
# TOKENS_RATE_PER_MIN=10000

# --- Ingest CLI password (optional; -password flag overrides) ---
# INGEST_PASSWORD=secret123
